# MediKiosk AI Backend Configuration

# JWT Secret
SECRET_KEY=medikiosk-clinical-secret-key-2026-secure-jwt

# Primary Database (MySQL)
# Update with your MySQL credentials (if MySQL is not configured, system will automatically fall back to SQLite)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=medikiosk_db

# Optional direct connection string:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/medikiosk_db

# Optional AI API Key (Gemini or OpenAI)
# If left empty, MediKiosk will run seamlessly using its clinical rule-based engine
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
